CXX = clang++
AR = llvm-ar
ROOT = `{realpath "$PWD/.."}
DEBUG_FLAGS = -g -O0
CXX_FLAGS = $DEBUG_FLAGS -std=c++20 \
  -Wall -Werror -Wpedantic -Wextra \
  -I$ROOT/include/ \
  $DEBUGFLAGS
DEPFILES = `{/bin/sh -c 'find . -maxdepth 1 -name "*.d"'}

<|cat $DEPFILES /dev/null

text-debugger: text-debugger.o debug.o libvm.a
  $CXX -lncurses \
    $prereq \
    -o $target

# r = replace or add objects to file
# c = create if it doesn't already exist
# s = write an index
libvm.a: instructions.o rom.o word.o vm.o
  $AR rcs $target $prereq

%.o: $ROOT/bin/%.cpp
  $CXX $CXX_FLAGS -c $prereq -o $target

%.o: $ROOT/lib/%.cpp
  $CXX $CXX_FLAGS -c $prereq -o $target

clean:V:
  rm -f *.o *.d *.so text-debugger libvm.a
