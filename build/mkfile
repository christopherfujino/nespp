CXX = clang++
ROOT = `{realpath "$PWD/.."}
DEBUG_FLAGS = -g -O0
CXX_FLAGS = -std=c++20 \
  -Wall -Werror -Wpedantic -Wextra \
  -I$ROOT/include/ \
  -fPIC \
  $DEBUGFLAGS
LD_FLAGS = -L$ROOT/build -lvm
DEPFILES = `{/bin/sh -c 'find . -maxdepth 1 -name "*.d"'}

<|cat $DEPFILES /dev/null

run:V: text-debugger
  ldd $prereq | grep libvm

text-debugger: text-debugger.o debug.o libvm.so
  $CXX $LD_FLAGS -lncurses \
    text-debugger.o debug.o \
    -o $target

libvm.so: instructions.o rom.o word.o vm.o
  $CXX -fPIC -shared $prereq -o $target

%.o: $ROOT/bin/%.cpp
  $CXX $CXX_FLAGS -c $prereq -o $target

%.o: $ROOT/lib/%.cpp
  $CXX $CXX_FLAGS -c $prereq -o $target

clean:V:
  rm -f *.o *.d *.so text-debugger
